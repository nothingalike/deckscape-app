{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "paths": { "@/*": ["./src/deckscape/*"], "@desktop/*": ["./src/renderer/*"], "next/link": ["./src/desktop/link.tsx"] },
    "skipLibCheck": true,
    "lib": ["ES2023", "DOM"],
    "types": ["node", "react", "react-dom"],
    "ignoreDeprecations": "6.0"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "tests/**/*.ts"]
}
